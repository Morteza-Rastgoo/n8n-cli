#!/bin/bash

# ===================================================================
# n8n Advanced CLI Tool
# Comprehensive workflow management for n8n instances
# ===================================================================

set -e

# Load environment configuration with proper precedence
load_env() {
    local env_file="${1:-.env}"
    
    if [[ -f "$env_file" ]]; then
        # Read .env file line by line and only set if not already set
        while IFS='=' read -r key value; do
            # Skip comments and empty lines
            [[ "$key" =~ ^#.*$ ]] && continue
            [[ -z "$key" ]] && continue
            
            # Remove quotes from value
            value=$(echo "$value" | sed 's/^[\"'"'"']//; s/[\"'"'"']$//')
            
            # Only set if not already set (environment variables take precedence)
            if [[ -z "${!key}" ]]; then
                export "$key"="$value"
            fi
        done < "$env_file"
        echo "✓ Loaded configuration from $env_file" >&2
    else
        echo "⚠ Configuration file $env_file not found, using defaults" >&2
    fi
}

# Load configuration
load_env

# Configuration with defaults
N8N_URL="${N8N_URL:-https://n8n.com}"
N8N_API_KEY="${N8N_API_KEY:-}"
DEFAULT_BACKUP_DIR="${DEFAULT_BACKUP_DIR:-./backups}"
DEFAULT_EXECUTION_LIMIT="${DEFAULT_EXECUTION_LIMIT:-20}"
DEFAULT_BENCHMARK_ITERATIONS="${DEFAULT_BENCHMARK_ITERATIONS:-5}"
DEFAULT_EXECUTION_TIMEOUT="${DEFAULT_EXECUTION_TIMEOUT:-3600}"  # 1 hour default
DEFAULT_POLLING_INTERVAL="${DEFAULT_POLLING_INTERVAL:-5}"      # 5 seconds default
ENABLE_DEBUG="${ENABLE_DEBUG:-false}"
ENABLE_COLORS="${ENABLE_COLORS:-true}"
API_TIMEOUT="${API_TIMEOUT:-30}"
API_MAX_RETRIES="${API_MAX_RETRIES:-3}"

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for output (configurable)
if [[ "$ENABLE_COLORS" == "true" ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    PURPLE='\033[0;35m'
    CYAN='\033[0;36m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    PURPLE=''
    CYAN=''
    NC=''
fi

# Utility functions - All log output goes to stderr to prevent JSON contamination
log() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
debug() { [[ "$ENABLE_DEBUG" == "true" ]] && echo -e "${CYAN}[DEBUG]${NC} $1" >&2; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1" >&2; }

# Enhanced configuration validation
validate_config() {
    local errors=0
    
    if [[ -z "$N8N_API_KEY" ]]; then
        error "N8N_API_KEY not set. Please check your .env file or environment variables."
        ((errors++))
    fi
    
    if [[ -z "$N8N_URL" ]]; then
        error "N8N_URL not set. Please check your .env file or environment variables."
        ((errors++))
    fi
    
    # Validate URL format
    if [[ -n "$N8N_URL" && ! "$N8N_URL" =~ ^https?:// ]]; then
        error "N8N_URL must start with http:// or https://"
        ((errors++))
    fi
    
    # Validate API key format (should be base64-like)
    if [[ -n "$N8N_API_KEY" && ${#N8N_API_KEY} -lt 20 ]]; then
        warn "N8N_API_KEY seems too short, please verify it's correct"
    fi
    
    if [[ $errors -gt 0 ]]; then
        return 1
    fi
    
    debug "Configuration validated: URL=$N8N_URL"
    return 0
}

# Enhanced API request function with better error handling and debugging
api_request() {
    local method="$1"
    local endpoint="$2"
    local data="$3"
    local extra_headers="$4"
    local max_retries="${API_MAX_RETRIES:-3}"
    local retry_count=0
    
    # Validate required parameters
    if [[ -z "$N8N_URL" || -z "$N8N_API_KEY" ]]; then
        error "Configuration not properly loaded. Run validate_config first."
        return 1
    fi
    
    local url="${N8N_URL}/api/v1${endpoint}"
    
    debug "API Request: $method $url"
    [[ -n "$data" ]] && debug "Request data: ${data:0:200}$([ ${#data} -gt 200 ] && echo "...")"
    
    while [[ $retry_count -lt $max_retries ]]; do
        local response
        local http_code
        local curl_exit_code
        
        if [[ "$method" == "GET" ]]; then
            response=$(curl -s -w "\\n%{http_code}" -X GET "$url" \
                -H "X-N8N-API-KEY: $N8N_API_KEY" \
                -H "Content-Type: application/json" \
                --max-time "${API_TIMEOUT:-30}" \
                $extra_headers 2>/dev/null)
            curl_exit_code=$?
        else
            response=$(curl -s -w "\\n%{http_code}" -X "$method" "$url" \
                -H "X-N8N-API-KEY: $N8N_API_KEY" \
                -H "Content-Type: application/json" \
                --max-time "${API_TIMEOUT:-30}" \
                $extra_headers \
                -d "$data" 2>/dev/null)
            curl_exit_code=$?
        fi
        
        # Handle curl errors
        if [[ $curl_exit_code -ne 0 ]]; then
            warn "Network error (curl exit code: $curl_exit_code), retrying..."
            ((retry_count++))
            sleep $((retry_count))
            continue
        fi
        
        # Extract HTTP status code (last line)
        if [[ -n "$response" ]]; then
            http_code=$(echo "$response" | tail -n1)
            response=$(echo "$response" | sed '$d')  # Remove last line
        else
            http_code="000"
            response=""
        fi
        
        debug "HTTP Status: $http_code"
        [[ "$ENABLE_DEBUG" == "true" && -n "$response" ]] && debug "Response: ${response:0:200}$([ ${#response} -gt 200 ] && echo "...")"
        
        # Check for successful response
        if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
            echo "$response"
            return 0
        elif [[ "$http_code" == "401" ]]; then
            error "Authentication failed. Please check your API key."
            echo "$response"
            return 1
        elif [[ "$http_code" == "404" ]]; then
            error "Resource not found (404)"
            echo "$response"
            return 1
        elif [[ "$http_code" == "429" ]]; then
            # Rate limited, wait and retry
            warn "Rate limited (429), retrying in $((retry_count + 2)) seconds..."
            sleep $((retry_count + 2))
        elif [[ "$http_code" =~ ^5[0-9][0-9]$ ]]; then
            # Server error, retry
            warn "Server error ($http_code), retrying in $((retry_count + 1)) seconds..."
            sleep $((retry_count + 1))
        else
            # Client error or other, don't retry
            error "Request failed with HTTP $http_code"
            echo "$response"
            return 1
        fi
        
        ((retry_count++))
    done
    
    error "Request failed after $max_retries retries"
    echo "$response"
    return 1
}

# ===================================================================
# WORKFLOW MANAGEMENT FUNCTIONS
# ===================================================================

# List all workflows
list_workflows() {
    log "Fetching workflows from $N8N_URL..."
    
    local response=$(api_request "GET" "/workflows")
    
    # Check if we got a valid JSON response with data
    if ! echo "$response" | jq -e '.data' >/dev/null 2>&1; then
        error "Failed to fetch workflows: $response"
        return 1
    fi
    
    echo "$response" | jq -r '.data[] | "\(.id) | \(.name) | \(.active) | \(.updatedAt)"' | column -t -s '|'
    
    local count=$(echo "$response" | jq '.data | length')
    success "Found $count workflows"
}

# Get workflow by ID or name
get_workflow() {
    local identifier="$1"
    
    if [[ -z "$identifier" ]]; then
        error "Workflow ID or name required"
        return 1
    fi
    
    # Parse URL if provided (extract workflow ID from URL like https://n8n.com/workflow/QFErgCBsHyJn9glG/executions/184843)
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    log "Fetching workflow: $identifier"
    
    # Try by ID first (n8n IDs are alphanumeric, not just numeric)
    if [[ "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local response=$(api_request "GET" "/workflows/$identifier")
        
        # Check if we got a valid response (direct workflow response doesn't have .data wrapper)
        if echo "$response" | jq -e '.id' >/dev/null 2>&1; then
            echo "$response" | jq . 2>/dev/null || echo "$response"
            return 0
        fi
    fi
    
    # If ID lookup failed, search by name
    local all_workflows=$(api_request "GET" "/workflows")
    local workflow_id=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$identifier\") | .id")
    
    if [[ -z "$workflow_id" ]]; then
        error "Workflow '$identifier' not found"
        return 1
    fi
    
    local response=$(api_request "GET" "/workflows/$workflow_id")
    
    # Check if we got a valid JSON response
    if ! echo "$response" | jq -e '.' >/dev/null 2>&1; then
        error "Failed to fetch workflow: $response"
        return 1
    fi
    
    echo "$response" | jq . 2>/dev/null || echo "$response"
}

# Create workflow
create_workflow() {
    local workflow_file="$1"
    
    if [[ -z "$workflow_file" ]]; then
        error "Workflow JSON file required"
        return 1
    fi
    
    if [[ ! -f "$workflow_file" ]]; then
        error "File not found: $workflow_file"
        return 1
    fi
    
    log "Creating workflow from: $workflow_file"
    
    local workflow_data=$(cat "$workflow_file")
    local response=$(api_request "POST" "/workflows" "$workflow_data")
    
    if [[ "$response" == *"error"* ]]; then
        error "Failed to create workflow: $response"
        return 1
    fi
    
    # Validate JSON before processing
    if ! echo "$response" | jq . >/dev/null 2>&1; then
        error "Invalid JSON response from API"
        return 1
    fi
    
    local workflow_id=$(echo "$response" | jq -r '.id // empty')
    local workflow_name=$(echo "$response" | jq -r '.name // empty')
    
    success "Created workflow: $workflow_name (ID: $workflow_id)"
    echo "$response" | jq . 2>/dev/null || echo "$response"
}

# Update workflow
update_workflow() {
    local identifier="$1"
    local workflow_file="$2"
    
    if [[ -z "$identifier" || -z "$workflow_file" ]]; then
        error "Workflow ID/name and JSON file required"
        return 1
    fi
    
    if [[ ! -f "$workflow_file" ]]; then
        error "File not found: $workflow_file"
        return 1
    fi
    
    log "Updating workflow: $identifier"
    
    # Parse URL if provided
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    # Get workflow ID if name provided (only search by name if not alphanumeric)
    if [[ ! "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local all_workflows=$(api_request "GET" "/workflows")
        identifier=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$identifier\") | .id")
        
        if [[ -z "$identifier" ]]; then
            error "Workflow not found"
            return 1
        fi
    fi
    
    local workflow_data=$(cat "$workflow_file")
    local response=$(api_request "PUT" "/workflows/$identifier" "$workflow_data")
    
    if [[ "$response" == *"error"* ]]; then
        error "Failed to update workflow: $response"
        return 1
    fi
    
    success "Updated workflow: $identifier"
    echo "$response" | jq . 2>/dev/null || echo "$response"
}

# Delete workflow
delete_workflow() {
    local identifier="$1"
    
    if [[ -z "$identifier" ]]; then
        error "Workflow ID or name required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    # Get workflow ID if name provided (only search by name if not alphanumeric)
    if [[ ! "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local all_workflows=$(api_request "GET" "/workflows")
        local workflow_name="$identifier"
        identifier=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$workflow_name\") | .id")
        
        if [[ -z "$identifier" ]]; then
            error "Workflow '$workflow_name' not found"
            return 1
        fi
    fi
    
    warn "Are you sure you want to delete workflow ID $identifier? (y/N)"
    read -r confirmation
    
    if [[ "$confirmation" != "y" && "$confirmation" != "Y" ]]; then
        log "Deletion cancelled"
        return 0
    fi
    
    log "Deleting workflow: $identifier"
    
    local response=$(api_request "DELETE" "/workflows/$identifier")
    
    if [[ "$response" == *"error"* ]]; then
        error "Failed to delete workflow: $response"
        return 1
    fi
    
    success "Deleted workflow: $identifier"
}

# Activate/Deactivate workflow
toggle_workflow() {
    local identifier="$1"
    local action="$2"  # activate or deactivate
    
    if [[ -z "$identifier" || -z "$action" ]]; then
        error "Workflow ID/name and action (activate/deactivate) required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    # Get workflow ID if name provided (only search by name if not alphanumeric)
    if [[ ! "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local all_workflows=$(api_request "GET" "/workflows")
        identifier=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$identifier\") | .id")
        
        if [[ -z "$identifier" ]]; then
            error "Workflow not found"
            return 1
        fi
    fi
    
    local endpoint="/workflows/$identifier"
    if [[ "$action" == "activate" ]]; then
        endpoint="${endpoint}/activate"
    else
        endpoint="${endpoint}/deactivate"
    fi
    
    if [[ "$action" == "activate" ]]; then
        log "Activating workflow: $identifier"
    else
        log "Deactivating workflow: $identifier"
    fi
    
    local response=$(api_request "POST" "$endpoint" "{}")
    
    # Check if the API call succeeded (200 status is success for activate/deactivate)
    if [[ $? -ne 0 ]]; then
        local error_msg=$(echo "$response" | jq -r '.message // "Unknown error"' 2>/dev/null || echo "API request failed")
        error "Failed to $action workflow: $error_msg"
        return 1
    fi
    
    if [[ "$action" == "activate" ]]; then
        success "Activated workflow: $identifier"
    else
        success "Deactivated workflow: $identifier"
    fi
}

# Execute workflow with enhanced waiting capabilities
execute_workflow() {
    local identifier="$1"
    local input_data="$2"
    local wait_for_completion="${3:-true}"  # Default to waiting
    local timeout="${4:-$DEFAULT_EXECUTION_TIMEOUT}"
    local polling_interval="${5:-$DEFAULT_POLLING_INTERVAL}"
    
    if [[ -z "$identifier" ]]; then
        error "Workflow ID or name required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    # Get workflow ID if name provided (only search by name if not alphanumeric)
    if [[ ! "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local all_workflows=$(api_request "GET" "/workflows")
        identifier=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$identifier\") | .id")
        
        if [[ -z "$identifier" ]]; then
            error "Workflow not found"
            return 1
        fi
    fi
    
    log "Executing workflow: $identifier"
    
    local data="${input_data:-{}}"
    local response=$(api_request "POST" "/workflows/$identifier/execute" "$data")
    local api_exit_code=$?
    
    if [[ $api_exit_code -ne 0 ]]; then
        error "Failed to execute workflow"
        return 1
    fi
    
    # Check if response indicates an error
    if echo "$response" | jq -e '.message' >/dev/null 2>&1; then
        local error_msg=$(echo "$response" | jq -r '.message')
        if [[ "$error_msg" == *"error"* ]] || [[ "$error_msg" == *"failed"* ]]; then
            error "Failed to execute workflow: $error_msg"
            return 1
        fi
    fi
    
    # Try to extract execution ID from different possible response formats
    local execution_id=""
    if echo "$response" | jq -e '.data.id' >/dev/null 2>&1; then
        execution_id=$(echo "$response" | jq -r '.data.id')
    elif echo "$response" | jq -e '.id' >/dev/null 2>&1; then
        execution_id=$(echo "$response" | jq -r '.id')
    fi
    
    if [[ -n "$execution_id" && "$execution_id" != "null" ]]; then
        success "Started execution: $execution_id"
        
        if [[ "$wait_for_completion" == "true" ]]; then
            log "Waiting for execution completion (timeout: ${timeout}s, polling every ${polling_interval}s)..."
            wait_for_execution "$execution_id" "$timeout" "$polling_interval"
            return $?
        fi
    else
        success "Workflow execution triggered"
    fi
    
    # Only output JSON if not waiting
    if [[ "$wait_for_completion" != "true" ]]; then
        if echo "$response" | jq . >/dev/null 2>&1; then
            echo "$response" | jq .
        else
            echo "$response"
        fi
    fi
}

# Wait for execution completion with detailed monitoring
wait_for_execution() {
    local execution_id="$1"
    local timeout="${2:-$DEFAULT_EXECUTION_TIMEOUT}"
    local polling_interval="${3:-$DEFAULT_POLLING_INTERVAL}"
    
    if [[ -z "$execution_id" ]]; then
        error "Execution ID required"
        return 1
    fi
    
    local start_time=$(date +%s)
    local end_time=$((start_time + timeout))
    local last_status="unknown"
    local dots_count=0
    
    while true; do
        local current_time=$(date +%s)
        
        # Check timeout
        if [[ $current_time -gt $end_time ]]; then
            echo ""
            warn "⏰ Execution timeout reached (${timeout}s)"
            warn "Execution may still be running. Check manually with: ./n8n-cli execution $execution_id"
            return 2
        fi
        
        # Get execution details
        local execution_data=$(api_request "GET" "/executions/$execution_id" 2>/dev/null)
        
        if echo "$execution_data" | jq -e '.id' >/dev/null 2>&1; then
            local status=$(echo "$execution_data" | jq -r '.status // "unknown"')
            local mode=$(echo "$execution_data" | jq -r '.mode // "unknown"')
            local elapsed_time=$((current_time - start_time))
            
            # Show progress indicator for running executions
            if [[ "$status" == "running" || "$status" == "new" || "$status" == "waiting" ]]; then
                if [[ "$last_status" != "$status" ]]; then
                    if [[ "$last_status" != "unknown" ]]; then
                        echo "" # New line after dots
                    fi
                    log "Status: $status (${elapsed_time}s elapsed)"
                    last_status="$status"
                    dots_count=0
                fi
                
                # Show progress dots
                printf "."
                dots_count=$((dots_count + 1))
                
                # New line every 60 dots (5 minutes at 5s intervals)
                if [[ $((dots_count % 60)) -eq 0 ]]; then
                    echo " (${elapsed_time}s)"
                    dots_count=0
                fi
                
                sleep "$polling_interval"
                continue
            fi
            
            # Execution completed
            echo "" # New line after dots
            
            local stopped_at=$(echo "$execution_data" | jq -r '.stoppedAt // "unknown"')
            local started_at=$(echo "$execution_data" | jq -r '.startedAt // "unknown"')
            
            echo ""
            echo "🎯 Execution Completed"
            echo "===================="
            echo "ID: $execution_id"
            echo "Status: $status"
            echo "Mode: $mode"
            echo "Started: $started_at"
            echo "Stopped: $stopped_at"
            echo "Total Time: ${elapsed_time}s"
            echo ""
            
            if [[ "$status" == "success" ]]; then
                success "✅ Execution completed successfully!"
                
                # Show output data if available
                local output_data=$(echo "$execution_data" | jq '.data.resultData.runData // {}')
                if [[ "$output_data" != "{}" && "$output_data" != "null" ]]; then
                    echo ""
                    echo "📋 Execution Output:"
                    echo "==================="
                    echo "$output_data" | jq .
                fi
                
                return 0
                
            elif [[ "$status" == "error" ]]; then
                error "❌ Execution failed!"
                
                # Show error details
                local error_data=$(echo "$execution_data" | jq '.data.resultData.error // {}')
                if [[ "$error_data" != "{}" && "$error_data" != "null" ]]; then
                    echo ""
                    echo "🚨 Error Details:"
                    echo "================"
                    echo "$error_data" | jq .
                fi
                
                # Show node execution data for debugging
                local run_data=$(echo "$execution_data" | jq '.data.resultData.runData // {}')
                if [[ "$run_data" != "{}" && "$run_data" != "null" ]]; then
                    echo ""
                    echo "🔍 Node Execution Data:"
                    echo "======================="
                    echo "$run_data" | jq 'to_entries | map({node: .key, status: (.value[0].error // "success"), data: (.value[0].data // "no data")})'
                fi
                
                return 1
                
            else
                warn "⚠️  Execution ended with status: $status"
                echo "$execution_data" | jq .
                return 1
            fi
        else
            error "Failed to get execution details"
            return 1
        fi
    done
}

# Search workflows by name or content
search_workflows() {
    local search_term="$1"
    local search_type="${2:-name}"  # name, content, or both
    
    if [[ -z "$search_term" ]]; then
        error "Search term required"
        return 1
    fi
    
    log "Searching workflows for: '$search_term' (type: $search_type)"
    
    local response=$(api_request "GET" "/workflows")
    
    if ! echo "$response" | jq -e '.data' >/dev/null 2>&1; then
        error "Failed to fetch workflows: $response"
        return 1
    fi
    
    local results
    case "$search_type" in
        "name")
            results=$(echo "$response" | jq -r ".data[] | select(.name | test(\"$search_term\"; \"i\")) | \"\(.id) | \(.name) | \(.active) | \(.updatedAt)\"")
            ;;
        "content")
            # Search in nodes and connections (requires full workflow data)
            results=$(echo "$response" | jq -r ".data[] | select(((.nodes // []) | tostring) + ((.connections // {}) | tostring) | test(\"$search_term\"; \"i\")) | \"\(.id) | \(.name) | \(.active) | \(.updatedAt)\"")
            ;;
        "both")
            results=$(echo "$response" | jq -r ".data[] | select((.name | test(\"$search_term\"; \"i\")) or (((.nodes // []) | tostring) + ((.connections // {}) | tostring) | test(\"$search_term\"; \"i\"))) | \"\(.id) | \(.name) | \(.active) | \(.updatedAt)\"")
            ;;
        *)
            error "Invalid search type. Use: name, content, or both"
            return 1
            ;;
    esac
    
    if [[ -n "$results" ]]; then
        echo "ID | NAME | ACTIVE | UPDATED"
        echo "$results" | column -t -s '|'
        local count=$(echo "$results" | wc -l | tr -d ' ')
        success "Found $count matching workflow(s)"
    else
        warn "No workflows found matching '$search_term'"
    fi
}

