main() {
    local command="$1"
    shift || true
    
    case "$command" in
        # Workflow management
        "list"|"ls")
            list_workflows "$@"
            ;;
        "search"|"find")
            search_workflows "$@"
            ;;
        "get"|"show")
            get_workflow "$@"
            ;;
        "create"|"add")
            create_workflow "$@"
            ;;
        "update"|"edit")
            update_workflow "$@"
            ;;
        "delete"|"rm")
            delete_workflow "$@"
            ;;
        "activate"|"enable")
            toggle_workflow "$1" "activate"
            ;;
        "deactivate"|"disable")
            toggle_workflow "$1" "deactivate"
            ;;
        "execute"|"run")
            execute_workflow "$@"
            ;;
        "execute-wait"|"exec-wait")
            execute_workflow "$1" "$2" "true" "$3" "$4"
            ;;
        "execute-nowait"|"exec-nowait")
            execute_workflow "$1" "$2" "false"
            ;;
        "wait-execution"|"wait-exec")
            wait_for_execution "$@"
            ;;
            
        # Execution management
        "executions"|"execs")
            list_executions "$@"
            ;;
        "execution"|"exec")
            get_execution_details "$@"
            ;;
        "exec-full")
            get_execution_details "$1" "true"
            ;;
        "stop-execution"|"stop")
            stop_execution "$@"
            ;;
        "delete-execution"|"del-exec")
            delete_execution "$@"
            ;;
            
        # User management
        "users")
            list_users "$@"
            ;;
        "user")
            get_user "$@"
            ;;
            
        # Credential management
        "credentials"|"creds")
            list_credentials "$@"
            ;;
        "credential"|"cred")
            get_credential "$@"
            ;;
            
        # Advanced workflow features
        "duplicate"|"dup")
            duplicate_workflow "$@"
            ;;
            
        # Webhook management
        "webhook"|"wh")
            send_webhook "$@"
            ;;
        "test-webhook"|"test-wh")
            test_webhook "$@"
            ;;
            
        # Backup and restore
        "backup")
            backup_workflows "$@"
            ;;
        "restore")
            restore_workflows "$@"
            ;;
        "list-backups")
            list_backups "$@"
            ;;
        "verify-backup")
            verify_backup "$@"
            ;;
            
