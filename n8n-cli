        "export")
            export_template "$@"
            ;;
        "import")
            import_template "$@"
            ;;
            
        # Monitoring
        "stats"|"status")
            get_stats "$@"
            ;;
        "monitor"|"watch")
            monitor_executions "$@"
            ;;
            
        # Validation and deployment
        "validate")
            validate_workflow "$@"
            ;;
        "deploy"|"deploy-workflow")
            deploy_workflow "$@"
            ;;
        "compare")
            compare_workflows "$@"
            ;;
            
        # Utility
        "help"|"-h"|"--help")
            show_help
            ;;
        "version"|"-v"|"--version")
            show_version
            ;;
        "test")
            test_connection
            ;;
        "test-all")
            run_comprehensive_tests "$@"
            ;;
        "benchmark")
            benchmark_api "$@"
            ;;
        "debug")
            set -x
            log "Debug mode enabled"
            ;;
            
        # Default
        "")
            show_help
            ;;
        *)
            error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

