# List executions
list_executions() {
    local workflow_id="$1"
    local limit="${2:-$DEFAULT_EXECUTION_LIMIT}"
    
    # Parse workflow ID from URL if provided
    if [[ "$workflow_id" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        workflow_id="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $workflow_id"
    fi
    
    local endpoint="/executions"
    if [[ -n "$workflow_id" ]]; then
        endpoint="${endpoint}?workflowId=$workflow_id&limit=$limit"
    else
        endpoint="${endpoint}?limit=$limit"
    fi
    
    log "Fetching executions..."
    
    local response=$(api_request "GET" "$endpoint")
    
    # Check if we got valid data - the response format is correct, just contains 'data'
    if ! echo "$response" | jq -e '.data' >/dev/null 2>&1; then
        error "Invalid response format: $response"
        return 1
    fi
    
    # Enhanced output with better formatting
    echo "ID | WORKFLOW | STATUS | MODE | STARTED | STOPPED"
    echo "$response" | jq -r '.data[] | "\(.id) | \(.workflowId // "N/A") | \(.status) | \(.mode // "N/A") | \(.startedAt) | \(.stoppedAt // "Running")"' | column -t -s '|'
    
    local count=$(echo "$response" | jq '.data | length')
    success "Found $count executions"
    
    # Show summary statistics
    if [[ $count -gt 0 ]]; then
        local successful=$(echo "$response" | jq '.data | map(select(.status == "success")) | length')
        local failed=$(echo "$response" | jq '.data | map(select(.status == "error")) | length')
        local running=$(echo "$response" | jq '.data | map(select(.status == "running")) | length')
        
        echo ""
        log "Summary: ✅ $successful successful, ❌ $failed failed, 🔄 $running running"
    fi
}

# Enhanced execution details with better formatting
get_execution_details() {
    local execution_id="$1"
    local show_data="${2:-false}"
    
    if [[ -z "$execution_id" ]]; then
        error "Execution ID required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$execution_id" =~ https?://[^/]+/workflow/[^/]+/executions/([^/]+) ]]; then
        execution_id="${BASH_REMATCH[1]}"
        log "Extracted execution ID from URL: $execution_id"
    fi
    
    log "Fetching execution details: $execution_id"
    
    local response=$(api_request "GET" "/executions/$execution_id")
    
    # Check if response contains valid execution data
    if ! echo "$response" | jq -e '.id' >/dev/null 2>&1; then
        error "Failed to fetch execution or invalid response: $response"
        return 1
    fi
    
    if [[ "$show_data" == "true" ]]; then
        echo "$response" | jq .
    else
        # Show formatted summary
        echo "🔍 Execution Summary"
        echo "==================="
        echo "$response" | jq -r '"ID: " + .id'
        echo "$response" | jq -r '"Workflow: " + (.workflowId // "N/A")'
        echo "$response" | jq -r '"Status: " + .status'
        echo "$response" | jq -r '"Mode: " + (.mode // "N/A")'
        echo "$response" | jq -r '"Started: " + .startedAt'
        echo "$response" | jq -r '"Stopped: " + (.stoppedAt // "Still running")'
        
        if echo "$response" | jq -e '.status == "success"' >/dev/null; then
            success "Execution completed successfully"
        elif echo "$response" | jq -e '.status == "error"' >/dev/null; then
            error "Execution failed"
            # Show error details if available
            if echo "$response" | jq -e '.data.resultData.error' >/dev/null 2>&1; then
                echo "$response" | jq -r '.data.resultData.error.message // "No error message available"'
            fi
        else
            log "Execution is in progress"
        fi
    fi
}

