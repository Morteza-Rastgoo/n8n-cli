# List all credentials
list_credentials() {
    log "Fetching credentials from $N8N_URL..."
    
    local response=$(api_request "GET" "/credentials" 2>/dev/null)
    local exit_code=$?
    
    if [[ $exit_code -ne 0 ]]; then
        warn "Credentials endpoint not available or access denied"
        echo "This feature may require Enterprise license or different permissions"
        return 1
    fi
    
    if ! echo "$response" | jq -e '.data' >/dev/null 2>&1; then
        warn "Credentials endpoint returned: $response"
        return 1
    fi
    
    echo "ID | NAME | TYPE | SHARED"
    echo "$response" | jq -r '.data[] | "\(.id) | \(.name) | \(.type) | \(.sharedWith // [] | length > 0)"' | column -t -s '|'
    
    local count=$(echo "$response" | jq '.data | length')
    success "Found $count credentials"
}

# Get credential by ID
get_credential() {
    local credential_id="$1"
    
    if [[ -z "$credential_id" ]]; then
        error "Credential ID required"
        return 1
    fi
    
    log "Fetching credential: $credential_id"
    
    local response=$(api_request "GET" "/credentials/$credential_id" 2>/dev/null)
    local exit_code=$?
    
    if [[ $exit_code -ne 0 ]]; then
        error "Failed to fetch credential or access denied"
        return 1
    fi
    
    if ! echo "$response" | jq -e '.id' >/dev/null 2>&1; then
        error "Failed to fetch credential: $response"
        return 1
    fi
    
    echo "$response" | jq .
}

