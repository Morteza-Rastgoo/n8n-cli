# Validate workflow JSON structure
validate_workflow() {
    local workflow_file="$1"
    
    if [[ -z "$workflow_file" ]]; then
        error "Workflow file required"
        return 1
    fi
    
    if [[ ! -f "$workflow_file" ]]; then
        error "File not found: $workflow_file"
        return 1
    fi
    
    log "Validating workflow: $workflow_file"
    
    # Check JSON syntax
    if ! jq '.' "$workflow_file" >/dev/null 2>&1; then
        error "Invalid JSON syntax in workflow file"
        return 1
    fi
    
    # Check required fields
    local workflow_data=$(cat "$workflow_file")
    
    if ! echo "$workflow_data" | jq -e '.name' >/dev/null 2>&1; then
        error "Missing required field: name"
        return 1
    fi
    
    if ! echo "$workflow_data" | jq -e '.nodes' >/dev/null 2>&1; then
        error "Missing required field: nodes"
        return 1
    fi
    
    if ! echo "$workflow_data" | jq -e '.connections' >/dev/null 2>&1; then
        error "Missing required field: connections"
        return 1
    fi
    
    local node_count=$(echo "$workflow_data" | jq '.nodes | length')
    local workflow_name=$(echo "$workflow_data" | jq -r '.name')
    
    success "Workflow validation passed"
    log "Name: $workflow_name"
    log "Nodes: $node_count"
    
    return 0
}

# Deploy workflow with validation
deploy_workflow() {
    local workflow_file="$1"
    local workflow_id="$2"
    
    if [[ -z "$workflow_file" ]]; then
        error "Workflow file required"
        return 1
    fi
    
    # Validate first
    if ! validate_workflow "$workflow_file"; then
        error "Workflow validation failed"
        return 1
    fi
    
    if [[ -n "$workflow_id" ]]; then
        log "Updating existing workflow: $workflow_id"
        update_workflow "$workflow_id" "$workflow_file"
    else
        log "Creating new workflow"
        create_workflow "$workflow_file"
    fi
}

# Compare two workflows
compare_workflows() {
    local workflow1="$1"
    local workflow2="$2"
    
    if [[ -z "$workflow1" || -z "$workflow2" ]]; then
        error "Two workflow identifiers required"
        return 1
    fi
    
    log "Comparing workflows: $workflow1 vs $workflow2"
    
    # Get workflow data using direct API calls
    local wf1_response wf2_response
    wf1_response=$(api_request "GET" "/workflows/$workflow1")
    wf2_response=$(api_request "GET" "/workflows/$workflow2")
    
    if ! echo "$wf1_response" | jq -e '.id' >/dev/null 2>&1; then
        error "Failed to fetch workflow: $workflow1"
        return 1
    fi
    
    if ! echo "$wf2_response" | jq -e '.id' >/dev/null 2>&1; then
        error "Failed to fetch workflow: $workflow2"
        return 1
    fi
    
    # Compare key fields
    local wf1_name wf2_name wf1_nodes wf2_nodes wf1_active wf2_active
    wf1_name=$(echo "$wf1_response" | jq -r '.name // "Unknown"')
    wf2_name=$(echo "$wf2_response" | jq -r '.name // "Unknown"')
    wf1_nodes=$(echo "$wf1_response" | jq '.nodes | length')
    wf2_nodes=$(echo "$wf2_response" | jq '.nodes | length')
    wf1_active=$(echo "$wf1_response" | jq -r '.active // false')
    wf2_active=$(echo "$wf2_response" | jq -r '.active // false')
    
    echo ""
    echo "🔍 Workflow Comparison"
    echo "====================="
    echo "Workflow 1: $wf1_name ($workflow1)"
    echo "  Nodes: $wf1_nodes"
    echo "  Status: $(if [[ "$wf1_active" == "true" ]]; then echo "✅ Active"; else echo "⭕ Inactive"; fi)"
    echo ""
    echo "Workflow 2: $wf2_name ($workflow2)"
    echo "  Nodes: $wf2_nodes"
    echo "  Status: $(if [[ "$wf2_active" == "true" ]]; then echo "✅ Active"; else echo "⭕ Inactive"; fi)"
    echo ""
    
    # Comparison summary
    echo "📊 Comparison Summary"
    echo "===================="
    if [[ "$wf1_nodes" != "$wf2_nodes" ]]; then
        warn "⚠️  Different number of nodes: $wf1_nodes vs $wf2_nodes"
    else
        success "✅ Same number of nodes: $wf1_nodes"
    fi
    
    if [[ "$wf1_active" != "$wf2_active" ]]; then
        warn "⚠️  Different active status"
    else
        success "✅ Same active status"
    fi
}

