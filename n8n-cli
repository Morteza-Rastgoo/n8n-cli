# Send webhook request
send_webhook() {
    local webhook_path="$1"
    local data="$2"
    local method="${3:-POST}"
    
    if [[ -z "$webhook_path" ]]; then
        error "Webhook path required (e.g., 'ffmpeg-result' or '/webhook/ffmpeg-result')"
        return 1
    fi
    
    # Normalize webhook path - add /webhook/ prefix if not present
    if [[ ! "$webhook_path" =~ ^/webhook/ ]]; then
        if [[ "$webhook_path" =~ ^/ ]]; then
            webhook_path="/webhook${webhook_path}"
        else
            webhook_path="/webhook/${webhook_path}"
        fi
    fi
    
    local url="${N8N_URL}${webhook_path}"
    log "Sending $method request to webhook: $url"
    
    local webhook_data="${data:-{}}"
    local response
    local http_code
    
    if [[ "$method" == "GET" ]]; then
        response=$(curl -s -w "\\n%{http_code}" -X GET "$url" \
            -H "Content-Type: application/json" 2>/dev/null)
    else
        response=$(curl -s -w "\\n%{http_code}" -X "$method" "$url" \
            -H "Content-Type: application/json" \
            --data-raw "$webhook_data" 2>/dev/null)
    fi
    
    if [[ -n "$response" ]]; then
        http_code=$(echo "$response" | tail -n1)
        response=$(echo "$response" | sed '$d')
    else
        http_code="000"
        response="No response"
    fi
    
    # Display response
    echo "$response"
    
    # Check HTTP status code
    if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
        success "Webhook request sent successfully (HTTP $http_code)"
        return 0
    elif [[ "$http_code" == "404" ]]; then
        error "Webhook not found (HTTP 404)"
        return 1
    elif [[ "$http_code" =~ ^4[0-9][0-9]$ ]]; then
        error "Client error (HTTP $http_code)"
        return 1
    elif [[ "$http_code" =~ ^5[0-9][0-9]$ ]]; then
        error "Server error (HTTP $http_code)"
        return 1
    else
        error "Request failed (HTTP $http_code)"
        return 1
    fi
}

# Test webhook connectivity with enhanced validation
test_webhook() {
    local webhook_path="$1"
    
    if [[ -z "$webhook_path" ]]; then
        error "Webhook path required"
        return 1
    fi
    
    log "Testing webhook connectivity: $webhook_path"
    
    # Normalize webhook path
    if [[ ! "$webhook_path" =~ ^/webhook/ ]]; then
        if [[ "$webhook_path" =~ ^/ ]]; then
            webhook_path="/webhook${webhook_path}"
        else
            webhook_path="/webhook/${webhook_path}"
        fi
    fi
    
    local url="${N8N_URL}${webhook_path}"
    local test_payload='{"test":"connectivity","timestamp":"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"}'
    
    debug "Testing URL: $url"
    debug "Test payload: $test_payload"
    
    local response
    local http_code
    
    response=$(curl -s -w "\\n%{http_code}" -X POST "$url" \
        -H "Content-Type: application/json" \
        --data-raw "$test_payload" \
        --max-time 30 2>/dev/null)
    
    if [[ -n "$response" ]]; then
        http_code=$(echo "$response" | tail -n1)
        response=$(echo "$response" | sed '$d')  # Remove last line
    else
        http_code="000"
        response="No response"
    fi
    
    echo "HTTP Status: $http_code"
    echo "Response: $response"
    
    if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
        success "Webhook is accessible and responding"
        return 0
    elif [[ "$http_code" == "404" ]]; then
        error "Webhook not found (404) - check if workflow is active"
        return 1
    elif [[ "$http_code" == "401" || "$http_code" == "403" ]]; then
        error "Authentication error ($http_code)"
        return 1
    else
        error "Webhook test failed with HTTP $http_code"
        return 1
    fi
}

