# Stop execution
stop_execution() {
    local execution_id="$1"
    
    if [[ -z "$execution_id" ]]; then
        error "Execution ID required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$execution_id" =~ https?://[^/]+/workflow/[^/]+/executions/([^/]+) ]]; then
        execution_id="${BASH_REMATCH[1]}"
        log "Extracted execution ID from URL: $execution_id"
    fi
    
    log "Stopping execution: $execution_id"
    
    local response=$(api_request "POST" "/executions/$execution_id/stop" "{}")
    
    if [[ "$response" == *"error"* ]]; then
        error "Failed to stop execution: $response"
        return 1
    fi
    
    success "Execution stopped: $execution_id"
    echo "$response" | jq .
}

# Delete execution
delete_execution() {
    local execution_id="$1"
    
    if [[ -z "$execution_id" ]]; then
        error "Execution ID required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$execution_id" =~ https?://[^/]+/workflow/[^/]+/executions/([^/]+) ]]; then
        execution_id="${BASH_REMATCH[1]}"
        log "Extracted execution ID from URL: $execution_id"
    fi
    
    warn "Are you sure you want to delete execution $execution_id? (y/N)"
    read -r confirmation
    
    if [[ "$confirmation" != "y" && "$confirmation" != "Y" ]]; then
        log "Deletion cancelled"
        return 0
    fi
    
    log "Deleting execution: $execution_id"
    
    local response=$(api_request "DELETE" "/executions/$execution_id")
    
    if [[ "$response" == *"error"* ]]; then
        error "Failed to delete execution: $response"
        return 1
    fi
    
    success "Execution deleted: $execution_id"
}

