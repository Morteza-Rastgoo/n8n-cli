# WORKFLOW SHARING AND ADVANCED FEATURES
# ===================================================================

# Duplicate workflow
duplicate_workflow() {
    local identifier="$1"
    local new_name="$2"
    
    if [[ -z "$identifier" ]]; then
        error "Workflow ID or name required"
        return 1
    fi
    
    # Parse URL if provided
    if [[ "$identifier" =~ https?://[^/]+/workflow/([^/]+) ]]; then
        identifier="${BASH_REMATCH[1]}"
        log "Extracted workflow ID from URL: $identifier"
    fi
    
    # Get workflow ID if name provided
    if [[ ! "$identifier" =~ ^[a-zA-Z0-9]+$ ]]; then
        local all_workflows=$(api_request "GET" "/workflows")
        identifier=$(echo "$all_workflows" | jq -r ".data[] | select(.name == \"$identifier\") | .id")
        
        if [[ -z "$identifier" ]]; then
            error "Workflow not found"
            return 1
        fi
    fi
    
    log "Duplicating workflow: $identifier"
    
    # Try the duplicate endpoint first
    local request_data="{}"
    if [[ -n "$new_name" ]]; then
        request_data=$(echo '{}' | jq --arg name "$new_name" '.name = $name')
    fi
    
    local response=$(api_request "POST" "/workflows/$identifier/duplicate" "$request_data" 2>/dev/null)
    local exit_code=$?
    
    if [[ $exit_code -eq 0 ]] && echo "$response" | jq -e '.id' >/dev/null 2>&1; then
        local new_workflow_id=$(echo "$response" | jq -r '.id // empty')
        local new_workflow_name=$(echo "$response" | jq -r '.name // empty')
        success "Duplicated workflow: $new_workflow_name (ID: $new_workflow_id)"
        echo "$response" | jq .
        return 0
    fi
    
    # Fallback: Manual duplication by getting workflow and creating new one
    warn "Duplicate endpoint not available, using manual duplication"
    
    local workflow_data=$(get_workflow "$identifier")
    if [[ $? -ne 0 ]]; then
        error "Failed to get source workflow for duplication"
        return 1
    fi
    
    # Modify the workflow for duplication
    local duplicate_name="${new_name:-$(echo "$workflow_data" | jq -r '.name') Copy}"
    local clean_workflow=$(echo "$workflow_data" | jq --arg name "$duplicate_name" 'del(.id, .createdAt, .updatedAt, .versionId) | .name = $name')
    
    # Create temporary file
    local temp_file=$(mktemp)
    echo "$clean_workflow" > "$temp_file"
    
    # Create the duplicate
    local result=$(create_workflow "$temp_file")
    local create_exit_code=$?
    
    # Clean up temp file
    rm -f "$temp_file"
    
    if [[ $create_exit_code -eq 0 ]]; then
        success "Successfully duplicated workflow manually"
        echo "$result"
        return 0
    else
        error "Failed to duplicate workflow: $result"
        return 1
    fi
}

