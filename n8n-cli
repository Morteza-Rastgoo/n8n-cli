# Enhanced backup with metadata and validation
backup_workflows() {
    local backup_dir="${1:-$DEFAULT_BACKUP_DIR}"
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="$backup_dir/n8n_backup_$timestamp.json"
    
    mkdir -p "$backup_dir"
    
    log "Creating enhanced backup..."
    
    local response=$(api_request "GET" "/workflows")
    
    # Check if we got a valid JSON response with data
    if ! echo "$response" | jq -e '.data' >/dev/null 2>&1; then
        error "Failed to fetch workflows for backup: $response"
        return 1
    fi
    
    # Get additional metadata
    local instance_stats=$(get_stats 2>/dev/null || echo "{}")
    local cli_version=$(show_version | head -1)
    
    # Create enhanced backup structure
    local backup_data=$(cat << EOF
{
    "backup_info": {
        "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)",
        "source": "$N8N_URL",
        "cli_version": "$cli_version",
        "backup_type": "full",
        "created_by": "n8n-cli"
    },
    "workflows": $response,
    "metadata": {
        "total_workflows": $(echo "$response" | jq '.data | length'),
        "active_workflows": $(echo "$response" | jq '.data | map(select(.active == true)) | length'),
        "backup_size_bytes": $(echo "$response" | wc -c)
    }
}
EOF
)
    
    echo "$backup_data" | jq . > "$backup_file"
    
    local count=$(echo "$response" | jq '.data | length')
    local file_size=$(ls -lh "$backup_file" | awk '{print $5}')
    
    success "Enhanced backup created: $backup_file"
    log "Workflows backed up: $count"
    log "Backup file size: $file_size"
    
    # Create backup index
    local index_file="$backup_dir/backup_index.json"
    local index_entry=$(cat << EOF
{
    "timestamp": "$timestamp",
    "file": "$(basename "$backup_file")",
    "workflows": $count,
    "size": "$file_size",
    "path": "$backup_file"
}
EOF
)
    
    if [[ -f "$index_file" ]]; then
        # Add to existing index
        jq ". += [$index_entry]" "$index_file" > "${index_file}.tmp" && mv "${index_file}.tmp" "$index_file"
    else
        # Create new index
        echo "[$index_entry]" | jq . > "$index_file"
    fi
    
    success "Backup index updated: $index_file"
}

# List available backups
list_backups() {
    local backup_dir="${1:-$DEFAULT_BACKUP_DIR}"
    
    if [[ ! -d "$backup_dir" ]]; then
        error "Backup directory not found: $backup_dir"
        return 1
    fi
    
    local index_file="$backup_dir/backup_index.json"
    
    if [[ -f "$index_file" ]]; then
        log "Available backups from index:"
        echo "TIMESTAMP | FILE | WORKFLOWS | SIZE"
        jq -r '.[] | "\(.timestamp) | \(.file) | \(.workflows) | \(.size)"' "$index_file" | column -t -s '|'
    else
        log "Scanning backup directory for files..."
        find "$backup_dir" -name "n8n_backup_*.json" -exec basename {} \; | sort
    fi
}

# Verify backup integrity
verify_backup() {
    local backup_file="$1"
    
    if [[ -z "$backup_file" ]]; then
        error "Backup file required"
        return 1
    fi
    
    if [[ ! -f "$backup_file" ]]; then
        error "Backup file not found: $backup_file"
        return 1
    fi
    
    log "Verifying backup: $backup_file"
    
    # Check JSON validity
    if ! jq '.' "$backup_file" >/dev/null 2>&1; then
        error "Invalid JSON in backup file"
        return 1
    fi
    
    # Check backup structure
    local backup_data=$(cat "$backup_file")
    
    if ! echo "$backup_data" | jq -e '.workflows.data' >/dev/null 2>&1; then
        error "Invalid backup structure - missing workflows.data"
        return 1
    fi
    
    local workflow_count=$(echo "$backup_data" | jq '.workflows.data | length')
    local backup_timestamp=$(echo "$backup_data" | jq -r '.backup_info.timestamp // .timestamp')
    
    success "Backup verification passed"
    log "Backup timestamp: $backup_timestamp"
    log "Workflows in backup: $workflow_count"
    
    # Verify each workflow structure
    local invalid_workflows=0
    for ((i=0; i<workflow_count; i++)); do
        local workflow=$(echo "$backup_data" | jq ".workflows.data[$i]")
        if ! echo "$workflow" | jq -e '.name and .nodes and .connections' >/dev/null 2>&1; then
            ((invalid_workflows++))
        fi
    done
    
    if [[ $invalid_workflows -gt 0 ]]; then
        warn "Found $invalid_workflows workflows with invalid structure"
    else
        success "All workflows have valid structure"
    fi
    
    return 0
}

# Restore workflows from backup with enhanced validation
restore_workflows() {
    local backup_file="$1"
    
    if [[ -z "$backup_file" ]]; then
        error "Backup file required"
        return 1
    fi
    
    if [[ ! -f "$backup_file" ]]; then
        error "Backup file not found: $backup_file"
        return 1
    fi
    
    # Verify backup first
    if ! verify_backup "$backup_file"; then
        error "Backup verification failed"
        return 1
    fi
    
    log "Restoring workflows from: $backup_file"
    
    local backup_data=$(cat "$backup_file")
    local total_workflows=$(echo "$backup_data" | jq '.workflows.data | length')
    local count=0
    local failed=0
    
    warn "This will restore $total_workflows workflows. Continue? (y/N)"
    read -r confirmation
    
    if [[ "$confirmation" != "y" && "$confirmation" != "Y" ]]; then
        log "Restore cancelled"
        return 0
    fi
    
    echo "$backup_data" | jq -r '.workflows.data[]' | while IFS= read -r workflow; do
        if [[ -n "$workflow" ]]; then
            local name=$(echo "$workflow" | jq -r '.name')
            log "Restoring: $name"
            
            # Remove fields that shouldn't be in create request
            local clean_workflow=$(echo "$workflow" | jq 'del(.id, .createdAt, .updatedAt, .versionId)')
            
            local response=$(api_request "POST" "/workflows" "$clean_workflow")
            
            if echo "$response" | jq -e '.id' >/dev/null 2>&1; then
                ((count++))
                success "✅ Restored: $name"
            else
                ((failed++))
                warn "❌ Failed to restore $name: $response"
            fi
        fi
    done
    
    success "Restore completed: $count successful, $failed failed"
}

